# Dirección del servicio Ray Head
RAY_HEAD_SERVICE_HOST=ray-head

# Configuración de los nodos
NODE_ROLE=worker
LEADER_NODE=false
FAILOVER_PRIORITY=3
ENABLE_AUTO_FAILOVER=false

# Configuración de la API
API_BASE_URL=http://ml-api:8000

# Configuración de la memoria compartida
SHM_SIZE_HEAD=2.5gb
SHM_SIZE_WORKER=2gb